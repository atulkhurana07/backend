# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chargeease
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/chargeease

# JWT
JWT_SECRET_KEY=CHANGE-ME-TO-A-RANDOM-SECRET-IN-PRODUCTION
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# MQTT (future)
MQTT_BROKER_URL=
MQTT_BROKER_PORT=1883

# Redis (optional)
REDIS_URL=

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=true

# Telemetry
TELEMETRY_MAX_FUTURE_SECONDS=60
TELEMETRY_MAX_SPEED_KPH=200
TELEMETRY_POOR_GPS_ACCURACY_M=50
